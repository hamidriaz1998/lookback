#!/usr/bin/env bash
# Fast checks on what this commit records. The index is exported to a temp dir, and the checks run there, so
# an unstaged fix cannot approve a broken staged file.
set -euo pipefail
export CGO_ENABLED=0

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/src/"
git diff --cached --name-only -z --diff-filter=ACMR -- '*.go' > "$tmp/files.nul"
mapfile -d '' -t files < "$tmp/files.nul"

cd "$tmp/src"
if ((${#files[@]})); then
	bad=$(gofmt -l -- "${files[@]}")
	if [[ -n $bad ]]; then
		printf 'pre-commit: run gofmt on:\n%s\n' "$bad" >&2
		exit 1
	fi
	go vet ./...
	# Packages of the staged files that still exist as packages (go list drops the rest).
	mapfile -t pkgs < <(printf './%s\n' "${files[@]}" | xargs -n1 dirname | sort -u | xargs go list 2>/dev/null || true)
	if ((${#pkgs[@]})); then
		go test -short "${pkgs[@]}"
	fi
fi
bash scripts/check-colors.sh
