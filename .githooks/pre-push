#!/usr/bin/env bash
# Full checks before code leaves the machine: all tests, the Windows cross-build (keeps Linux-only code
# out of shared packages), and the race detector on the Go packages this push changes.
set -euo pipefail
export CGO_ENABLED=0

go vet ./...
go test ./...
GOOS=windows go build ./...
bash scripts/check-colors.sh

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per pushed ref.
zero=0000000000000000000000000000000000000000
changed=()
while read -r _ local_sha _ remote_sha; do
	[[ $local_sha == "$zero" ]] && continue # deleting a ref
	base=$remote_sha
	[[ $base == "$zero" ]] && base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
	if [[ -n $base ]]; then
		mapfile -t -O "${#changed[@]}" changed < <(git diff --name-only "$base" "$local_sha" -- '*.go')
	fi
done
if ((${#changed[@]})); then
	mapfile -t pkgs < <(printf './%s\n' "${changed[@]}" | xargs -n1 dirname | sort -u | xargs go list 2>/dev/null || true)
	if ((${#pkgs[@]})); then
		CGO_ENABLED=1 go test -race -short "${pkgs[@]}" # the race detector needs cgo
	fi
fi
