#!/usr/bin/env bash
# Full checks on each commit that is pushed. Each commit is exported from git, so the checks run on the tree
# that is pushed, not on the working tree, whichever branch is checked out.
set -euo pipefail
export CGO_ENABLED=0

zero=0000000000000000000000000000000000000000

# check_commit <sha> <remote sha>: vet, all tests, the Windows build, the color check, and the race detector on
# the packages the commit changes.
check_commit() {
	local sha=$1 remote=$2 tmp base
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' RETURN
	git archive "$sha" | tar -x -C "$tmp"
	(
		cd "$tmp"
		go vet ./...
		go test ./...
		# Exported snapshots have no VCS metadata; ignore any parent repository markers.
		GOOS=windows go build -buildvcs=false ./...
		bash scripts/check-colors.sh
	)
	base=$remote
	[[ $base == "$zero" ]] && base=$(git merge-base "$sha" origin/main 2>/dev/null || echo "")
	if [[ -n $base ]]; then
		local changed=()
		mapfile -t changed < <(git diff --name-only "$base" "$sha" -- '*.go')
		if ((${#changed[@]})); then
			local pkgs=()
			mapfile -t pkgs < <(cd "$tmp" && printf './%s\n' "${changed[@]}" | xargs -n1 dirname | sort -u | xargs go list 2>/dev/null || true)
			if ((${#pkgs[@]})); then
				if [[ $(go env GOOS) == windows ]] && ! command -v gcc > /dev/null 2>&1; then
					# The race detector needs cgo, and Windows has no C compiler by default (SPEC "Windows phase").
					echo "pre-push: gcc not found, skipping -race (install MSYS2 ucrt64 gcc)" >&2
				else
					(cd "$tmp" && CGO_ENABLED=1 go test -race -short "${pkgs[@]}") # the race detector needs cgo
				fi
			fi
		fi
	fi
}

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per pushed ref.
declare -A seen=()
while read -r _ local_sha _ remote_sha; do
	[[ $local_sha == "$zero" ]] && continue # deleting a ref
	[[ -n ${seen[$local_sha]:-} ]] && continue
	seen[$local_sha]=1
	check_commit "$local_sha" "$remote_sha"
done
